<?xml version="1.0" encoding="utf-8"?>
<animNode>
	<m_Name>buBumped</m_Name>
	<m_AnimName>Bob_BU_Fall</m_AnimName>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.05</m_BlendTime>

	<m_Conditions>
		<m_Name>BumpFall</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>

	<m_Conditions>
		<m_Name>BumpFallType</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>drunk</m_Value>
	</m_Conditions>

	<m_Conditions>
		<m_Name>BumpType</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>stagger</m_Value>
	</m_Conditions>

	<!-- <m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>BumpDone=true</m_ParameterValue>
	</m_Events> -->

	<m_Events>
		<m_EventName>FallOnFront</m_EventName>
		<m_TimePc>0.5</m_TimePc>
		<m_ParameterValue>false</m_ParameterValue>
	</m_Events>

	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_TimePc>0.75</m_TimePc>
		<m_ParameterValue>BumpStaggered=false</m_ParameterValue>
	</m_Events>

	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>BumpFallAnimFinished=true</m_ParameterValue>
	</m_Events>

	<m_Events>
		<m_EventName>PlaySound</m_EventName>
		<m_TimePc>0.23</m_TimePc>
		<m_ParameterValue>FallLight</m_ParameterValue>
	</m_Events>

	<m_Events>
		<m_EventName>PlayerVoiceSound</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>PainFromFallLow</m_ParameterValue>
	</m_Events>

</animNode>